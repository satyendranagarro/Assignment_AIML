# Copy to .env and fill in values. Never commit .env.

# --- LLM provider ---
# openai (default) | gemini | cursor | fake (offline tests)
LLM_PROVIDER=openai
# Optional override for embeddings only (re-index Chroma after changing)
# EMBEDDING_PROVIDER=openai

# OpenAI (default)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini (LLM_PROVIDER=gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Cursor OpenAI-compatible gateway (LLM_PROVIDER=cursor)
CURSOR_API_KEY=
CURSOR_LLM_BASE_URL=
CURSOR_MODEL=gpt-4o-mini
# CURSOR_EMBEDDING_MODEL=text-embedding-3-small

# Optional Azure OpenAI (still LLM_PROVIDER=openai when endpoint+deployment set)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- Neo4j (Phase 4+) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Paths ---
CHROMA_PATH=data/chroma
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed

# --- MCP / tools ---
# Set true to use documented mock responses when MCP servers are unavailable (Phase 5+)
MCP_MOCK_MODE=false
WEATHER_MCP_URL=
CURRENCY_MCP_URL=

# --- App / observability ---
DESTINATION=Singapore
LOG_LEVEL=INFO
LOG_FORMAT=json
# LOG_FILE=logs/app.jsonl


