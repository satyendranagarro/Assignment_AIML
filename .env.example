# Copy to .env and fill in values. Never commit .env.

# --- LLM provider ---
# openai (default) | gemini | cursor | fake (offline tests)
LLM_PROVIDER=openai
# Optional override for embeddings only (re-index Chroma after changing)
# EMBEDDING_PROVIDER=openai

# OpenAI (default)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini (LLM_PROVIDER=gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Cursor online via cursor-sdk (LLM_PROVIDER=cursor) — default path
# Key: https://cursor.com/dashboard/integrations (cursor_... or crsr_...)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# cloud (no-repo VM) | local (scratch cwd)
CURSOR_RUNTIME=cloud
# Optional OpenAI-compatible gateway instead of SDK:
# CURSOR_USE_GATEWAY=true
# CURSOR_LLM_BASE_URL=http://localhost:8787/v1
# Always set a separate embeddings provider for RAG when using cursor chat:
# EMBEDDING_PROVIDER=fake

# Optional Azure OpenAI (still LLM_PROVIDER=openai when endpoint+deployment set)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- Neo4j (Phase 1.5 infra/neo4j + Phase 4 load) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Required for docker compose -f infra/neo4j/compose.yml up
NEO4J_PASSWORD=changeme

# --- Chroma (Phase 1.5 infra/chroma + Phase 4 load) ---
# Leave CHROMA_HOST empty to use local files under CHROMA_PATH (offline / CI).
# With Compose Chroma up, set:
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
CHROMA_PATH=data/chroma
# CHROMA_HOST=
# CHROMA_PORT=8000

# --- Paths ---
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed

# --- MCP / tools ---
# Set true to use documented mock responses when MCP servers are unavailable
MCP_MOCK_MODE=false
# Optional URLs if using remote MCP transports (agents default to in-process clients)
WEATHER_MCP_URL=
CURRENCY_MCP_URL=

# --- App / observability ---
DESTINATION=Singapore
# Streamlit container port when using infra/app (profile app)
STREAMLIT_PORT=8501
LOG_LEVEL=INFO
LOG_FORMAT=json
# LOG_FILE=logs/app.jsonl


